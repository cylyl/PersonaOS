# PersonaOS Runtime Environment Configuration
# Managed by Ansible for PVE2 Deployment

DATABASE_URL=postgresql+asyncpg://{{ database_user }}:{{ database_password }}@{{ database_host }}:{{ database_port }}/{{ database_name }}
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

API_HOST=0.0.0.0
API_PORT={{ control_plane_port }}
LOG_LEVEL={{ log_level }}
LOG_FORMAT=json

ENABLE_NODE_SUPERVISION=true
NODE_SUPERVISION_INTERVAL_SECONDS=10.0
NODE_HEARTBEAT_TIMEOUT_SECONDS=60.0
TASK_LEASE_TTL_SECONDS=300

MEMORY_ADAPTER={{ memory_adapter }}
{% if mem0_api_key is defined and mem0_api_key %}
MEM0_API_KEY={{ mem0_api_key }}
MEM0_BASE_URL={{ mem0_base_url | default('https://api.mem0.ai/v1') }}
{% endif %}

POLICIES_DIR=/etc/personaos/policies
PROFILES_DIR=/etc/personaos/profiles

# Worker process settings
WORKER_POLL_INTERVAL_SECONDS=2.0
RUNTIME_ADAPTER=openclaw
