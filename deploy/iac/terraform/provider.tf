# Terraform provider configuration for PersonaOS on Proxmox VE 2 (PVE2)
# Follows the infrastructure practice established in cyl-dc (bpg/proxmox provider)

terraform {
  required_version = ">= 1.5.0"
  required_providers {
    proxmox = {
      source  = "bpg/proxmox"
      version = "0.66.0"
    }
  }
}

provider "proxmox" {
  endpoint  = var.proxmox_endpoint
  api_token = var.proxmox_api_token
  insecure  = var.proxmox_insecure

  ssh {
    agent    = true
    username = "root"
  }
}
