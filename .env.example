# PersonaOS v0.1 environment variables
# Copy to .env and edit. .env is gitignored.

# Database
DATABASE_URL=postgresql+asyncpg://personaos:personaos@localhost:5432/personaos
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# API
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info

# Worker
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_HEARTBEAT_INTERVAL_SECONDS=15.0
TASK_LEASE_TTL_SECONDS=300

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Runtime adapter (v0.1 ships OpenClaw only)
RUNTIME_ADAPTER=openclaw
# OPENCLAW_API_URL=http://localhost:8001  # uncomment when OpenClaw adapter lands

# Security (v0.1 defaults — tighten in production)
POLICY_DEFAULT_EFFECT=deny
QUARANTINE_ENABLED=true
APPROVAL_TIMEOUT_SECONDS=86400
